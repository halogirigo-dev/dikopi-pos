      "html": "<div class=\"ds-toast-success\"><div class=\"ds-toast-icon\">✓</div><div class=\"ds-toast-title\">Transaksi Berhasil</div><div class=\"ds-toast-total\">Rp 54.000</div><div class=\"ds-toast-meta\">CASH • INV-20260907-001</div><button class=\"ds-btn-primary\">Selesai</button></div>",
