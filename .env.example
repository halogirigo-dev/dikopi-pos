# Supabase Postgres — get from Supabase Dashboard → Project Settings → Database → Connection String
# Use pooled connection (port 6543) for Vercel/serverless, direct (5432) for local migrate
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# For local prisma migrate with direct connection, uncomment:
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-random-32-char-min-untuk-production"

# Supabase keys (optional untuk storage jika pakai Supabase Storage untuk product images)
# NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."
